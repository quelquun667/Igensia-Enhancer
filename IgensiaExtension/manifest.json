{
  "manifest_version": 3,
  "name": "Igensia Enhancer",
  "version": "2.7.1",
  "description": "Améliore MonCampus Igensia : prochain cours, dernières notes, GPA et simulateur, devoirs par matière, absences, téléchargement des documents en PDF.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://moncampus.igensia-education.fr/*",
    "https://ws-notes-igs.wigorservices.net/*",
    "https://ws-edt-igs.wigorservices.net/*",
    "https://eabsences-igs.wigorservices.net/*",
    "https://cas-p.wigorservices.net/*",
    "https://api.github.com/repos/quelquun667/Igensia-Enhancer/releases/*",
    "https://raw.githubusercontent.com/quelquun667/Igensia-Enhancer/*",
    "https://*.igensia-education.fr/*",
    "https://*.igensia.com/*",
    "https://*.box.com/*",
    "https://*.boxcloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ws-notes-igs.wigorservices.net/Home/Releve*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://ws-notes-igs.wigorservices.net/home/releve*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://eabsences-igs.wigorservices.net/home/item*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://eabsences-igs.wigorservices.net/Home/Item*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://moncampus.igensia-education.fr/*"
      ],
      "js": [
        "inject_devoirs_tab.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ws-edt-igs.wigorservices.net/WebPsDyn.aspx*"
      ],
      "js": [
        "edt_content.js"
      ],
      "css": [
        "search.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.igensia-education.fr/*",
        "https://*.igensia.com/*"
      ],
      "js": [
        "pdf_timing.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.igensia-education.fr/*",
        "https://*.igensia.com/*"
      ],
      "js": [
        "lib/jspdf.umd.min.js",
        "pdf_viewer.js"
      ],
      "css": [
        "pdf_viewer.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "extension_home.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "search.css",
        "search.js"
      ],
      "matches": [
        "https://ws-edt-igs.wigorservices.net/*"
      ]
    }
  ]
}
